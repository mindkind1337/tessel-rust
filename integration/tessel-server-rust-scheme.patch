+it('returns a Rust sign-in to its own scheme and exchanges only its PKCE code', async () => {
+  const start = await pressButton(startUrl({ app: 'tessel-rust' }))
+  expect(start.status).toBe(303)
+  const provider = new URL(start.headers.get('location'))
+  google.answer = { ok: true, json: async () => ({ id_token: fakeIdToken(goodClaims(provider.searchParams.get('nonce'))) }) }
+  const response = await get(`/auth/google/callback?${new URLSearchParams({ state: provider.searchParams.get('state'), code: 'fixture-code' })}`)
+  expect(response.status).toBe(200)
+  const html = await response.text()
+  const match = html.match(/href="(tessel-rust:\/\/callback[^\"]+)"/)
+  expect(match).not.toBeNull()
+  const link = new URL(match[1].replaceAll('&amp;', '&'))
+  expect(link.searchParams.get('state')).toBe(CLIENT_STATE)
+  const body = { code: link.searchParams.get('code'), verifier: VERIFIER }
+  expect((await post('/auth/token', body)).status).toBe(200)
+  expect((await post('/auth/token', body)).status).toBe(400)
+})
